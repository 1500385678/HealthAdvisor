        { "name": "status", "type": "ENUM", "enum_values": ["active", "paused", "stopped", "completed"], "nullable": false, "default": "active" },
        { "name": "reminder_enabled", "type": "BOOLEAN", "nullable": false, "default": false, "description": "是否开启用药提醒" },
